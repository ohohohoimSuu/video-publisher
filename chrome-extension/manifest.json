{
  "manifest_version": 3,
  "name": "本地视频发布台 · 普通 Chrome 上传",
  "description": "在当前 Chrome 中打开任务平台，上传填写后由本人发布。",
  "version": "0.4.1",
  "minimum_chrome_version": "125",
  "permissions": [
    "storage",
    "alarms",
    "tabs",
    "debugger"
  ],
  "host_permissions": [
    "http://127.0.0.1:8765/*"
  ],
  "incognito": "not_allowed",
  "action": {
    "default_title": "视频发布台连接",
    "default_popup": "popup.html"
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'none'; connect-src http://127.0.0.1:8765 ws://127.0.0.1:*"
  },
  "background": {
    "service_worker": "upload-worker.js"
  },
  "content_scripts": [
    {
      "matches": [
        "http://127.0.0.1:8765/*"
      ],
      "js": [
        "page-bridge.js"
      ],
      "run_at": "document_idle",
      "all_frames": false
    }
  ]
}
